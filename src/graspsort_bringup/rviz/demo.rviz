# GraspSort demo RViz (Phase 7): YOLO detections image, planning scene, planned trajectory, robot.
# Same base as graspsort.rviz (ur_moveit_config/rviz/view_robot.rviz 2.14), without the
# MotionPlanning panel. Use with: sim.launch.py rviz:=true rviz_config:=<path to this file>
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Marker Scale: 0.3
      Frame Timeout: 15
      Value: false
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      Value: true
    - Class: moveit_rviz_plugin/PlanningScene
      Name: PlanningScene
      Enabled: true
      Move Group Namespace: ""
      Robot Description: robot_description
      Planning Scene Topic: /monitored_planning_scene
      Scene Geometry:
        Show Scene Geometry: true
        Scene Alpha: 0.9
        Scene Display Time: 0.01
        Voxel Rendering: Occupied Voxels
      Scene Robot:
        Show Robot Visual: false
        Show Robot Collision: false
        Robot Alpha: 1
      Value: true
    - Class: moveit_rviz_plugin/Trajectory
      Name: PlannedTrajectory
      Enabled: true
      Robot Description: robot_description
      Trajectory Topic: /display_planned_path
      Loop Animation: false
      Show Robot Visual: true
      Show Robot Collision: false
      Robot Alpha: 0.4
      Show Trail: true
      Trail Step Size: 3
      State Display Time: 0.05 s
      Interrupt Display: true
      Value: true
    - Class: rviz_default_plugins/Image
      Name: YOLO detections
      Enabled: true
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /detections/image
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 2.2
      Focal Point:
        X: 0.5
        Y: 0.0
        Z: 0.8
      Pitch: 0.6
      Yaw: 3.6
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Height: 1080
  Width: 1920
  Displays:
    collapsed: true
  Views:
    collapsed: true
  YOLO detections:
    collapsed: false
