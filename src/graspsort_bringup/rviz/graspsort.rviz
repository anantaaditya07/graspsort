# GraspSort RViz: MotionPlanning (group ur_manipulator), TF, colour camera image.
# Based on ur_moveit_config/rviz/view_robot.rviz (2.14), trimmed.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Marker Scale: 0.3
      Frame Timeout: 15
      Frames:
        All Enabled: false
        world:
          Value: true
        table:
          Value: true
        bin_cup:
          Value: true
        bin_bottle:
          Value: true
        bin_ball:
          Value: true
        camera_color_optical_frame:
          Value: true
        gripper_tcp:
          Value: true
        base_link:
          Value: true
      Value: true
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
      Enabled: true
      Move Group Namespace: ""
      Robot Description: robot_description
      Planning Scene Topic: monitored_planning_scene
      MoveIt_Planning_Attempts: 5
      MoveIt_Planning_Time: 5
      MoveIt_Allow_Replanning: false
      MoveIt_Use_Cartesian_Path: false
      Velocity_Scaling_Factor: 0.5
      Acceleration_Scaling_Factor: 0.5
      Planning Request:
        Planning Group: ur_manipulator
        Query Goal State: true
        Query Start State: false
        Interactive Marker Size: 0
      Planned Path:
        Trajectory Topic: /display_planned_path
        Loop Animation: false
        Show Trail: false
        State Display Time: 0.05 s
      Scene Geometry:
        Show Scene Geometry: true
        Scene Alpha: 0.9
      Scene Robot:
        Show Robot Visual: true
        Show Robot Collision: false
        Robot Alpha: 1
      Value: true
    - Class: rviz_default_plugins/Image
      Name: CameraColor
      Enabled: true
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/color/image_raw
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 3.0
      Focal Point:
        X: 0.5
        Y: 0.0
        Z: 0.3
      Pitch: 0.5
      Yaw: 3.6
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Height: 1000
  Width: 1600
  MotionPlanning:
    collapsed: false
