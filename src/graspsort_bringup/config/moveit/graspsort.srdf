<?xml version="1.0" encoding="UTF-8"?>
<!-- GraspSort SRDF for the UR5e + custom 2-finger gripper + fixed camera (graspsort_gazebo/urdf/graspsort_robot.urdf.xacro).
     Groups, end effector and named states written by hand; based on ur_moveit_config 2.14 srdf/ur_macro.srdf.xacro.
     The disable_collisions block is GENERATED, see the comment above it. -->
<robot name="ur">
  <!-- Arm. Chain ends at gripper_tcp so IK and pose targets are for the grasp point. -->
  <group name="ur_manipulator">
    <chain base_link="base_link" tip_link="gripper_tcp"/>
  </group>
  <!-- Gripper. gripper_right_finger_joint mimics gripper_left_finger_joint. -->
  <group name="gripper">
    <joint name="gripper_left_finger_joint"/>
    <joint name="gripper_right_finger_joint"/>
  </group>

  <!-- home = spawn pose (ur_description initial_positions.yaml), arm up, clear of table and camera. -->
  <group_state name="home" group="ur_manipulator">
    <joint name="shoulder_pan_joint" value="0.0"/>
    <joint name="shoulder_lift_joint" value="-1.57"/>
    <joint name="elbow_joint" value="0.0"/>
    <joint name="wrist_1_joint" value="-1.57"/>
    <joint name="wrist_2_joint" value="0.0"/>
    <joint name="wrist_3_joint" value="0.0"/>
  </group_state>
  <!-- ready = gripper pointing down above the object area. With world_layout.yaml (base_link at z 0.75)
       gripper_tcp is at world (0.510, -0.003, 1.118), i.e. 0.37 m above the table top at x 0.47..0.82. -->
  <group_state name="ready" group="ur_manipulator">
    <joint name="shoulder_pan_joint" value="-0.27"/>
    <joint name="shoulder_lift_joint" value="-1.57"/>
    <joint name="elbow_joint" value="1.57"/>
    <joint name="wrist_1_joint" value="-1.5708"/>
    <joint name="wrist_2_joint" value="-1.5708"/>
    <joint name="wrist_3_joint" value="0.0"/>
  </group_state>
  <!-- finger joint 0 = open (90 mm gap), 0.04 = closed (10 mm gap). Real grasps close width-based (D-02). -->
  <group_state name="open" group="gripper">
    <joint name="gripper_left_finger_joint" value="0.0"/>
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="gripper_left_finger_joint" value="0.04"/>
  </group_state>

  <end_effector name="gripper" group="gripper" parent_link="gripper_tcp" parent_group="ur_manipulator"/>

  <!-- disable_collisions, Setup Assistant rules (Adjacent, Default, Always, Never), regenerate with
       1. a copy of this SRDF whose generated block holds only the Adjacent pairs (or nothing)
       2. ros2 launch graspsort_bringup moveit.launch.py use_sim_time:=false srdf_file:=COPY
       3. ros2 run graspsort_bringup gen_disabled_collisions.py samples 10000, seed 0, srdf-out THIS_FILE
       moveit_setup_assistant collisions_updater hangs on this machine, hence the script.
       Seeds 0 and 1 gave identical pairs. camera_link has no collision geometry, so no camera pairs. -->
  <!-- BEGIN GENERATED disable_collisions -->
  <!-- generated by gen_disabled_collisions.py samples=10000 seed=0 always_fraction=0.95; 10 links with collision geometry; 20 of 45 pairs disabled -->
  <disable_collisions link1="base_link_inertia" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="gripper_base_link" link2="gripper_left_finger_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_base_link" link2="gripper_right_finger_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_base_link" link2="wrist_1_link" reason="Never"/>
  <disable_collisions link1="gripper_base_link" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="gripper_base_link" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_left_finger_link" link2="gripper_right_finger_link" reason="Never"/>
  <disable_collisions link1="gripper_left_finger_link" link2="wrist_1_link" reason="Never"/>
  <disable_collisions link1="gripper_left_finger_link" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="gripper_left_finger_link" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="gripper_right_finger_link" link2="wrist_1_link" reason="Never"/>
  <disable_collisions link1="gripper_right_finger_link" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="gripper_right_finger_link" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>
  <!-- END GENERATED disable_collisions -->
</robot>
