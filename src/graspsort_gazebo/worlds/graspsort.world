<?xml version="1.0"?>
<!--
  GraspSort world (Gazebo Classic 11, D-01). Geometry must match config/world_layout.yaml
  (single source of truth, checked by test/test_world_layout.py).
  Model poses
    pedestal  centre of its top face (= robot base_link pose)
    table     centre of the top surface
    bin_*     centre of the bin bottom face (resting on the table top)
    objects   model origin = bottom centre, upright
  The robot (entity "ur") and the RGB-D camera are NOT in this file. bringup spawns them from
  urdf/graspsort_robot.urdf.xacro.
-->
<sdf version="1.6">
  <world name="graspsort">
    <physics name="ode_1ms" type="ode" default="true">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver><type>quick</type><iters>50</iters><sor>1.3</sor></solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- Lighting as in Phase 0 C (the YOLO check passed with it) -->
    <light name="ceiling" type="point">
      <pose>0.47 0 2.6 0 0 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>10</range><constant>0.6</constant><linear>0.05</linear><quadratic>0.0</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>
    <!-- fill light from the camera side (+x) -->
    <light name="fill" type="directional">
      <pose>2.5 0 3 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <direction>-0.8 0.2 -0.6</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Ground truth for evaluation only (/gazebo/model_states, /gazebo/link_states) -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>20.0</update_rate>
    </plugin>

    <!-- Grasp attach plugin (D-03), services /attach and /detach (graspsort_msgs/srv/AttachLink) -->
    <plugin name="graspsort_attach" filename="libgraspsort_attach.so">
      <joint_type>fixed</joint_type>
      <attach_service>/attach</attach_service>
      <detach_service>/detach</detach_service>
    </plugin>

    <!-- Robot pedestal, 0.20 x 0.20 x 0.75 -->
    <model name="pedestal">
      <static>true</static>
      <pose>0 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <pose>0 0 -0.375 0 0 0</pose>
          <geometry><box><size>0.20 0.20 0.75</size></box></geometry>
        </collision>
        <visual name="v">
          <pose>0 0 -0.375 0 0 0</pose>
          <geometry><box><size>0.20 0.20 0.75</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Table, top 0.70 x 1.10 x 0.05, top surface at z 0.75 -->
    <model name="table">
      <static>true</static>
      <pose>0.47 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="top_c">
          <pose>0 0 -0.025 0 0 0</pose>
          <geometry><box><size>0.70 1.10 0.05</size></box></geometry>
        </collision>
        <visual name="top_v">
          <pose>0 0 -0.025 0 0 0</pose>
          <geometry><box><size>0.70 1.10 0.05</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
        <collision name="leg_1_c"><pose>0.30 0.50 -0.40 0 0 0</pose><geometry><box><size>0.05 0.05 0.70</size></box></geometry></collision>
        <visual name="leg_1_v"><pose>0.30 0.50 -0.40 0 0 0</pose><geometry><box><size>0.05 0.05 0.70</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <collision name="leg_2_c"><pose>0.30 -0.50 -0.40 0 0 0</pose><geometry><box><size>0.05 0.05 0.70</size></box></geometry></collision>
        <visual name="leg_2_v"><pose>0.30 -0.50 -0.40 0 0 0</pose><geometry><box><size>0.05 0.05 0.70</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <collision name="leg_3_c"><pose>-0.30 0.50 -0.40 0 0 0</pose><geometry><box><size>0.05 0.05 0.70</size></box></geometry></collision>
        <visual name="leg_3_v"><pose>-0.30 0.50 -0.40 0 0 0</pose><geometry><box><size>0.05 0.05 0.70</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <collision name="leg_4_c"><pose>-0.30 -0.50 -0.40 0 0 0</pose><geometry><box><size>0.05 0.05 0.70</size></box></geometry></collision>
        <visual name="leg_4_v"><pose>-0.30 -0.50 -0.40 0 0 0</pose><geometry><box><size>0.05 0.05 0.70</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>

    <!-- Bins, outer 0.20 x 0.20 x 0.08, walls 0.01, floor 0.01, open top -->
    <model name="bin_cup">
      <static>true</static>
      <pose>0.25 0.42 0.75 0 0 0</pose>
      <link name="link">
        <collision name="floor_c"><pose>0 0 0.005 0 0 0</pose><geometry><box><size>0.20 0.20 0.01</size></box></geometry></collision>
        <visual name="floor_v"><pose>0 0 0.005 0 0 0</pose><geometry><box><size>0.20 0.20 0.01</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material></visual>
        <collision name="wall_px_c"><pose>0.095 0 0.04 0 0 0</pose><geometry><box><size>0.01 0.20 0.08</size></box></geometry></collision>
        <visual name="wall_px_v"><pose>0.095 0 0.04 0 0 0</pose><geometry><box><size>0.01 0.20 0.08</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material></visual>
        <collision name="wall_nx_c"><pose>-0.095 0 0.04 0 0 0</pose><geometry><box><size>0.01 0.20 0.08</size></box></geometry></collision>
        <visual name="wall_nx_v"><pose>-0.095 0 0.04 0 0 0</pose><geometry><box><size>0.01 0.20 0.08</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material></visual>
        <collision name="wall_py_c"><pose>0 0.095 0.04 0 0 0</pose><geometry><box><size>0.18 0.01 0.08</size></box></geometry></collision>
        <visual name="wall_py_v"><pose>0 0.095 0.04 0 0 0</pose><geometry><box><size>0.18 0.01 0.08</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material></visual>
        <collision name="wall_ny_c"><pose>0 -0.095 0.04 0 0 0</pose><geometry><box><size>0.18 0.01 0.08</size></box></geometry></collision>
        <visual name="wall_ny_v"><pose>0 -0.095 0.04 0 0 0</pose><geometry><box><size>0.18 0.01 0.08</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material></visual>
      </link>
    </model>

    <model name="bin_bottle">
      <static>true</static>
      <pose>0.35 -0.42 0.75 0 0 0</pose>
      <link name="link">
        <collision name="floor_c"><pose>0 0 0.005 0 0 0</pose><geometry><box><size>0.20 0.20 0.01</size></box></geometry></collision>
        <visual name="floor_v"><pose>0 0 0.005 0 0 0</pose><geometry><box><size>0.20 0.20 0.01</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual>
        <collision name="wall_px_c"><pose>0.095 0 0.04 0 0 0</pose><geometry><box><size>0.01 0.20 0.08</size></box></geometry></collision>
        <visual name="wall_px_v"><pose>0.095 0 0.04 0 0 0</pose><geometry><box><size>0.01 0.20 0.08</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual>
        <collision name="wall_nx_c"><pose>-0.095 0 0.04 0 0 0</pose><geometry><box><size>0.01 0.20 0.08</size></box></geometry></collision>
        <visual name="wall_nx_v"><pose>-0.095 0 0.04 0 0 0</pose><geometry><box><size>0.01 0.20 0.08</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual>
        <collision name="wall_py_c"><pose>0 0.095 0.04 0 0 0</pose><geometry><box><size>0.18 0.01 0.08</size></box></geometry></collision>
        <visual name="wall_py_v"><pose>0 0.095 0.04 0 0 0</pose><geometry><box><size>0.18 0.01 0.08</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual>
        <collision name="wall_ny_c"><pose>0 -0.095 0.04 0 0 0</pose><geometry><box><size>0.18 0.01 0.08</size></box></geometry></collision>
        <visual name="wall_ny_v"><pose>0 -0.095 0.04 0 0 0</pose><geometry><box><size>0.18 0.01 0.08</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual>
      </link>
    </model>

    <model name="bin_ball">
      <static>true</static>
      <pose>0.50 0.42 0.75 0 0 0</pose>
      <link name="link">
        <collision name="floor_c"><pose>0 0 0.005 0 0 0</pose><geometry><box><size>0.20 0.20 0.01</size></box></geometry></collision>
        <visual name="floor_v"><pose>0 0 0.005 0 0 0</pose><geometry><box><size>0.20 0.20 0.01</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual>
        <collision name="wall_px_c"><pose>0.095 0 0.04 0 0 0</pose><geometry><box><size>0.01 0.20 0.08</size></box></geometry></collision>
        <visual name="wall_px_v"><pose>0.095 0 0.04 0 0 0</pose><geometry><box><size>0.01 0.20 0.08</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual>
        <collision name="wall_nx_c"><pose>-0.095 0 0.04 0 0 0</pose><geometry><box><size>0.01 0.20 0.08</size></box></geometry></collision>
        <visual name="wall_nx_v"><pose>-0.095 0 0.04 0 0 0</pose><geometry><box><size>0.01 0.20 0.08</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual>
        <collision name="wall_py_c"><pose>0 0.095 0.04 0 0 0</pose><geometry><box><size>0.18 0.01 0.08</size></box></geometry></collision>
        <visual name="wall_py_v"><pose>0 0.095 0.04 0 0 0</pose><geometry><box><size>0.18 0.01 0.08</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual>
        <collision name="wall_ny_c"><pose>0 -0.095 0.04 0 0 0</pose><geometry><box><size>0.18 0.01 0.08</size></box></geometry></collision>
        <visual name="wall_ny_v"><pose>0 -0.095 0.04 0 0 0</pose><geometry><box><size>0.18 0.01 0.08</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual>
      </link>
    </model>

    <!-- Objects (D-04). Unique names; models from models_external (scripts/fetch_models.sh) -->
    <include><name>ball_1</name><uri>model://cricket_ball</uri><pose>0.60 -0.12 0.75 0 0 0</pose></include>
    <include><name>ball_2</name><uri>model://cricket_ball</uri><pose>0.60 0.12 0.75 0 0 0</pose></include>
    <include><name>bottle_1</name><uri>model://mustard_bottle</uri><pose>0.38 -0.08 0.75 0 0 0</pose></include>
    <include><name>bottle_2</name><uri>model://mustard_bottle</uri><pose>0.38 0.10 0.75 0 0 0</pose></include>
  </world>
</sdf>
