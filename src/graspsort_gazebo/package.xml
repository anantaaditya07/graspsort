<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>graspsort_gazebo</name>
  <version>0.1.0</version>
  <description>GraspSort simulation assets: Gazebo Classic world (table, bins, objects), UR5e + gripper + RGB-D camera description, world layout config and the attach world plugin (D-03).</description>
  <maintainer email="anantaadityachavali@gmail.com">Ananta Aditya</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gazebo_dev</depend>
  <depend>gazebo_ros</depend>
  <depend>rclcpp</depend>
  <depend>graspsort_msgs</depend>

  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>gazebo_ros2_control</exec_depend>
  <exec_depend>ur_description</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-numpy</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>ur_description</test_depend>
  <test_depend>xacro</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <!-- ${prefix} is replaced by the package share dir (gazebo_ros_paths.py), so the plugin lib dir is ../../lib -->
    <gazebo_ros gazebo_model_path="${prefix}/models_external" plugin_path="${prefix}/../../lib"/>
  </export>
</package>
