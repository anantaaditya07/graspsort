<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>graspsort_manipulation</name>
  <version>0.1.0</version>
  <description>GraspSort manipulation: ROS-free header-only grasp planner (architecture 7.4) and class-to-bin assignment, with GoogleTests. The sort task node is added in a later phase.</description>
  <maintainer email="anantaadityachavali@gmail.com">Ananta Aditya</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>eigen3_cmake_module</buildtool_depend>
  <buildtool_export_depend>eigen3_cmake_module</buildtool_export_depend>

  <depend>eigen</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
