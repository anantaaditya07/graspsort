<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>graspsort_manipulation</name>
  <version>0.1.0</version>
  <description>GraspSort manipulation: ROS-free header-only grasp planner (architecture 7.4) and class-to-bin assignment, with GoogleTests, the ROS-free sort logic (sort_logic.hpp), the PickPlaceExecutor library (one pick-and-place, MoveGroupInterface), the Phase 4 scripted pick_place_test and the Phase 5 sort_task_node (SortObjects action server, architecture 7.5), with their trial harnesses.</description>
  <maintainer email="anantaadityachavali@gmail.com">Ananta Aditya</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>eigen3_cmake_module</buildtool_depend>
  <buildtool_export_depend>eigen3_cmake_module</buildtool_export_depend>

  <depend>eigen</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_msgs</depend>
  <depend>control_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>std_srvs</depend>
  <depend>graspsort_msgs</depend>

  <exec_depend>graspsort_gazebo</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
